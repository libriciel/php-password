<?xml version="1.0" encoding="UTF-8"?>
<project default="build">
    <property file="build.properties" />

    <!-- Vérification de la syntaxe des fichiers, passage des tests unitaires -->
	<target name="build" depends="clean,lint,phpunit"/>

    <!-- Un build et des analyses statiques de code, avec écriture de rapports -->
	<target name="quality" depends="clean,lint,phpunit-coverage,phpmd,phpcs,phploc,phpcpd,phpdoc,phpcb,pdepend"/>

    <!-- Vérification de la syntaxe des fichiers -->
    <target name="lint" depends="sh-lint,xml-lint,php-lint,po-lint,js-lint,css-lint"/>

	<!-- Suppression et création de l'environnement de travail -->
	<target name="clean">
        <delete dir="${dir.out}" />
		<mkdir dir="${dir.out}" />
		<mkdir dir="${dir.out}/images" />
	</target>
    
	<!-- Vérification de la syntaxe des fichiers SHELL -->
	<target name="sh-lint">
		<apply executable="bash" dir="${basedir}" failonerror="on" logerror="on">
			<arg line="-n"/>
			<fileset
				dir="${basedir}"
				includes="${sh.includes}"
				excludes="${sh.excludes}"
            />
		</apply>
	</target>
    
	<!-- Vérification de la syntaxe des fichiers XML -->
	<target name="xml-lint">
		<apply executable="xmllint" dir="${basedir}" failonerror="on" logerror="on">
			<arg line="--noout"/>
			<fileset
				dir="${basedir}"
				includes="${xml.includes}"
				excludes="${xml.excludes}"
            />
		</apply>
	</target>

	<!-- Vérification de la syntaxe des fichiers PHP -->
	<target name="php-lint">
		<apply executable="php" dir="${basedir}" failonerror="on" logerror="on">
			<arg line="-l"/>
			<fileset
				dir="${basedir}"
				includes="${php.includes}"
				excludes="${php.excludes}"
            />
		</apply>
	</target>

	<!-- Vérification de la syntaxe des fichiers PO -->
	<target name="po-lint">
		<apply executable="msgfmt" dir="${basedir}" failonerror="on" logerror="on">
			<arg line="-v"/>
			<arg line="-C"/>
			<arg line="-o /dev/null"/>
			<fileset
				dir="${basedir}"
				includes="${po.includes}"
				excludes="${po.excludes}"
            />
		</apply>
	</target>

	<!-- Vérification de la syntaxe des fichiers JS -->
	<!--
		@url http://ariya.ofilabs.com/2012/10/javascript-validator-with-esprima.html
		sudo aptitude install nodejs nodejs-legacy npm
		sudo npm install -g esprima
	-->
	<target name="js-lint">
		<apply executable="esvalidate" dir="${basedir}" failonerror="on" logerror="on">
			<fileset
				dir="${basedir}"
				includes="${js.includes}"
				excludes="${js.excludes}"
            />
		</apply>
	</target>

	<!-- Vérification de la syntaxe des fichiers CSS -->
    <!--
		@url https://github.com/stubbornella/csslint/wiki/Command-line-interface
		sudo aptitude install nodejs nodejs-legacy npm
		sudo npm install -g csslint
    -->
	<target name="css-lint">
		<apply executable="csslint" dir="${basedir}" failonerror="on" logerror="on">
			<arg line="--format=compact"/>
			<arg line="--warnings=display-property-grouping,duplicate-properties,empty-rules,known-properties"/>
			<fileset
				dir="${basedir}"
				includes="${css.includes}"
				excludes="${css.excludes}"
            />
		</apply>
	</target>
    
	<!-- Tests unitaires -->
	<target name="phpunit" depends="lint">
		<exec executable="${phpunit}" dir="${basedir}" failonerror="true">
			<arg line="tests" />
		</exec>
	</target>
    
	<!-- Tests unitaires avec rapports et couverture de code -->
	<target name="phpunit-coverage" depends="clean,lint">
		<exec executable="${phpunit}" dir="${basedir}" failonerror="true">
			<arg line="--log-junit=${dir.logs}/phpunit.xml
                --whitelist=src
                --coverage-html=${dir.out}/coverage
                --coverage-clover=${dir.logs}/phpunit-coverage.xml
                tests" />
		</exec>
	</target>

	<!-- Mess detector -->
	<target name="phpmd" depends="clean,lint">
		<exec executable="${phpmd}"
			dir="${basedir}"
			failonerror="false">
			<arg line="src
                xml
                cleancode,codesize,controversial,design,naming,unusedcode
                --reportfile ${dir.logs}/phpmd.xml"/>
		</exec>
	</target>

	<!-- Checkstyle -->
	<target name="phpcs" depends="clean,lint">
		<exec executable="${phpcs}"
			  dir="${basedir}"
			  output="${dir.logs}/phpcs.xml"
			  error="/dev/null"
			  failonerror="false">
			<arg line="--report=checkstyle
                       --standard=PSR2
                       src
                       tests" />
		</exec>
	</target>

	<!-- Mesures du code -->
	<target name="phploc" depends="clean,lint">
		<exec executable="${phploc}" dir="${basedir}">
			<arg line="--count-tests
                       --log-csv=${dir.logs}/phploc.csv
                       --log-xml=${dir.logs}/phploc.xml
                       ${basedir}/src
                       ${basedir}/tests" />
		</exec>
	</target>
    
	<!-- Détecteur de copier/coller -->
	<target name="phpcpd" depends="clean,lint">
		<exec executable="${phpcpd}"
			dir="${basedir}"
			failonerror="false">
			<arg line="--log-pmd=${dir.logs}/phpcpd.xml
                       ${basedir}/src
                       ${basedir}/tests" />
		</exec>
	</target>
    
	<!-- Documentation API -->
	<target name="phpdoc" depends="clean,lint">
		<exec executable="${phpdoc}"
			dir="${basedir}"
			failonerror="false">
			<arg line="-t ${dir.out}/phpdoc
                       -d ${basedir}/src
                       -d ${basedir}/tests" />
		</exec>
	</target>
    
	<!-- Navigateur de code -->
	<target name="phpcb" depends="clean,lint">
		<exec executable="${phpcb}"
			dir="${basedir}"
			failonerror="false">
			<arg line="-o ${dir.out}/phpcb
                       -s ${basedir}/src
                       -s ${basedir}/tests
                       --log ${dir.logs}" />
		</exec>
	</target>
    
	<!-- Dépendances -->
	<target name="pdepend" depends="clean,lint">
		<exec executable="${pdepend}"
			dir="${basedir}"
			failonerror="false">
			<arg line="--coverage-report=${dir.logs}/phpunit-coverage.xml
                       --dependency-xml=${dir.logs}/pdepend-dependency.xml
                       --jdepend-chart=${dir.out}/images/pdepend-jdepend-chart.svg
                       --jdepend-xml=${dir.logs}/pdepend-jdepend.xml
                       --overview-pyramid=${dir.out}/images/pdepend-overview-pyramid.svg
                       --summary-xml=${dir.logs}/pdepend-summary.xml
                       ${basedir}/src" />
		</exec>
	</target>

</project>