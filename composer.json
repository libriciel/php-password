{
    "name": "libriciel/php-password",
    "description": "Bibliothèque PHP permettant de calculer la force et l'entropie d'un mot de passe et de générer des mots de passes aléatoires.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Théo GUILLON",
            "homepage": "https://www.libriciel.fr",
            "email": "theo.guillon@libriciel.coop"
        }
    ],
    "autoload": {
        "psr-4": {
            "Libriciel\\Password\\": "src/",
            "LibricielTest\\Password\\": "tests/"
        }
    },
    "require": {
        "ext-json": "*",
        "ext-mbstring": "*",
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.8",
        "symplify/easy-coding-standard": "^13.3",
        "phpstan/phpstan-phpunit": "^2.1"
    },
    "config": {
        "platform": {
            "php": "8.4.28"
        }
    }
}
