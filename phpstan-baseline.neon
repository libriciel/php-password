# Erreurs présentes à l'introduction de PHPStan (niveau max), à résorber puis retirer d'ici.
# Dont un vrai bug : sprintf() avec trop d'arguments dans PasswordGeneratorAnssi::constrained().
# Le reste : types de tableaux non précisés, valeurs mixed, méthodes de test sans type de retour.
# Régénérer avec : vendor/bin/phpstan analyse --generate-baseline phpstan-baseline.neon
parameters:
	ignoreErrors:
		-
			message: '#^Binary operation "\.\=" between string and mixed results in an error\.$#'
			identifier: assignOp.invalid
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Call to sprintf contains 1 placeholder, 3 values given\.$#'
			identifier: argument.sprintf
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Method Libriciel\\Password\\Service\\PasswordGeneratorAnssi\:\:characters\(\) has parameter \$params with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Method Libriciel\\Password\\Service\\PasswordGeneratorAnssi\:\:characters\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Method Libriciel\\Password\\Service\\PasswordGeneratorAnssi\:\:config\(\) has parameter \$config with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Method Libriciel\\Password\\Service\\PasswordGeneratorAnssi\:\:config\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Method Libriciel\\Password\\Service\\PasswordGeneratorAnssi\:\:constrained\(\) has parameter \$mandatory with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Method Libriciel\\Password\\Service\\PasswordGeneratorAnssi\:\:constrained\(\) has parameter \$params with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Method Libriciel\\Password\\Service\\PasswordGeneratorAnssi\:\:defaults\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Method Libriciel\\Password\\Service\\PasswordGeneratorAnssi\:\:generate\(\) has parameter \$params with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Method Libriciel\\Password\\Service\\PasswordGeneratorAnssi\:\:randomArray\(\) has parameter \$array with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Method Libriciel\\Password\\Service\\PasswordGeneratorAnssi\:\:randomArray\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Parameter \#1 \$string of function mb_str_split expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Parameter \#1 \$string of function mb_strlen expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Parameter \#1 \$string of function mb_substr expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Parameter \#2 \$array of function implode expects array\<string\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Property Libriciel\\Password\\Service\\PasswordGeneratorAnssi\:\:\$classes type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Property Libriciel\\Password\\Service\\PasswordGeneratorAnssi\:\:\$config type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
			message: '#^Property Libriciel\\Password\\Service\\PasswordGeneratorAnssi\:\:\$defaults type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Service/PasswordGeneratorAnssi.php

		-
